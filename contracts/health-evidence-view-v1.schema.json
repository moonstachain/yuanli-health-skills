{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuanli.example/contracts/health-evidence-view-v1.schema.json",
  "title": "HealthEvidenceView v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "synthetic", "canonical_write", "persistence", "evidence_id", "source_type", "observed_window", "status", "fact", "provenance_reference", "freshness", "conflicts_with", "unknowns"],
  "properties": {
    "schema": {"const": "health-evidence-view-v1"},
    "synthetic": {"const": true},
    "canonical_write": {"const": false},
    "persistence": {"const": "none"},
    "evidence_id": {"$ref": "#/$defs/token"},
    "source_type": {"enum": ["self_report", "wearable_summary", "clinical_summary", "critical_campaign_calendar"]},
    "observed_window": {"$ref": "#/$defs/token"},
    "status": {"enum": ["supports", "contradicts", "unverified"]},
    "fact": {"$ref": "#/$defs/text"},
    "provenance_reference": {"$ref": "#/$defs/token"},
    "freshness": {"enum": ["current", "stale", "unknown"]},
    "conflicts_with": {"$ref": "#/$defs/references"},
    "unknowns": {"$ref": "#/$defs/text_array"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "contradicts"}}, "required": ["status"]},
      "then": {"properties": {"conflicts_with": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "token": {"type": "string", "pattern": "^synthetic:[a-z0-9][a-z0-9._:-]{0,127}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 280, "pattern": "^Synthetic [A-Za-z0-9 ./-]+\\.$"},
    "references": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
    "text_array": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
  }
}
