{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuanli.example/contracts/professional-escalation-v1.schema.json",
  "title": "ProfessionalEscalation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "synthetic", "canonical_write", "persistence", "escalation_id", "level", "trigger_category", "evidence_references", "final_authority", "guidance", "unknowns", "conflicts"],
  "properties": {
    "schema": {"const": "professional-escalation-v1"},
    "synthetic": {"const": true},
    "canonical_write": {"const": false},
    "persistence": {"const": "none"},
    "escalation_id": {"$ref": "#/$defs/token"},
    "level": {"enum": ["clinician", "emergency"]},
    "trigger_category": {"enum": ["clinical_request", "medication_change", "urgent_risk", "clinical_device_conflict"]},
    "evidence_references": {"$ref": "#/$defs/non_empty_references"},
    "final_authority": {"enum": ["clinician", "emergency_services"]},
    "guidance": {"$ref": "#/$defs/guidance"},
    "unknowns": {"$ref": "#/$defs/text_array"},
    "conflicts": {"$ref": "#/$defs/references"}
  },
  "allOf": [
    {
      "if": {"properties": {"level": {"const": "clinician"}}, "required": ["level"]},
      "then": {"properties": {"final_authority": {"const": "clinician"}}},
      "else": {"properties": {"final_authority": {"const": "emergency_services"}}}
    }
  ],
  "$defs": {
    "token": {"type": "string", "pattern": "^synthetic:[a-z0-9][a-z0-9._:-]{0,127}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 280},
    "guidance_text": {"type": "string", "minLength": 1, "maxLength": 160},
    "references": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
    "non_empty_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
    "text_array": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en"],
      "properties": {"zh": {"$ref": "#/$defs/guidance_text"}, "en": {"$ref": "#/$defs/guidance_text"}}
    }
  }
}
