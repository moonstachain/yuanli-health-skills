{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuanli.example/contracts/recovery-compass-snapshot-v1.schema.json",
  "title": "RecoveryCompassSnapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "synthetic", "canonical_write", "persistence", "directions", "season_focus", "unknowns", "conflicts", "authority_gate", "guardrails"],
  "properties": {
    "schema": {"const": "recovery-compass-snapshot-v1"},
    "synthetic": {"const": true},
    "canonical_write": {"const": false},
    "persistence": {"const": "none"},
    "directions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/direction"}, {"properties": {"direction": {"const": "sleep"}}}]},
        {"allOf": [{"$ref": "#/$defs/direction"}, {"properties": {"direction": {"const": "recovery"}}}]},
        {"allOf": [{"$ref": "#/$defs/direction"}, {"properties": {"direction": {"const": "stress_rhythm"}}}]},
        {"allOf": [{"$ref": "#/$defs/direction"}, {"properties": {"direction": {"const": "health_habits"}}}]}
      ],
      "items": false
    },
    "season_focus": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/focus"}]},
    "unknowns": {"$ref": "#/$defs/text_array"},
    "conflicts": {"$ref": "#/$defs/references"},
    "authority_gate": {"$ref": "#/$defs/authority_gate"},
    "guardrails": {"const": ["no_aggregate_score", "non_clinical"]}
  },
  "$defs": {
    "token": {"type": "string", "pattern": "^synthetic:[a-z0-9][a-z0-9._:-]{0,127}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 280, "pattern": "^Synthetic [A-Za-z0-9 ./-]+\\.$"},
    "references": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
    "text_array": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "trend", "evidence_references"],
      "properties": {
        "direction": {"enum": ["sleep", "recovery", "stress_rhythm", "health_habits"]},
        "trend": {"enum": ["improving", "stable", "declining", "insufficient_evidence"]},
        "evidence_references": {"$ref": "#/$defs/references"}
      },
      "allOf": [
        {
          "if": {"properties": {"trend": {"const": "insufficient_evidence"}}, "required": ["trend"]},
          "then": {"properties": {"evidence_references": {"maxItems": 0}}},
          "else": {"properties": {"evidence_references": {"minItems": 1}}}
        }
      ]
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "bottleneck_candidate", "rationale", "evidence_references"],
      "properties": {
        "direction": {"enum": ["sleep", "recovery", "stress_rhythm", "health_habits"]},
        "bottleneck_candidate": {"$ref": "#/$defs/token"},
        "rationale": {"$ref": "#/$defs/text"},
        "evidence_references": {"$ref": "#/$defs/non_empty_references"}
      }
    },
    "non_empty_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
    "authority_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "final_authority"],
      "properties": {"level": {"enum": ["GREEN", "YELLOW"]}, "final_authority": {"const": "subject"}}
    }
  }
}
