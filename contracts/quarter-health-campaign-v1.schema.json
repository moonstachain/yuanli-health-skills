{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuanli.example/contracts/quarter-health-campaign-v1.schema.json",
  "title": "QuarterHealthCampaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "synthetic", "canonical_write", "persistence", "decision_candidate_id", "phases", "active_phase", "current_weekly_experiment_reference", "candidate_state", "claims", "unknowns", "conflicts", "authority_gate"],
  "properties": {
    "schema": {"const": "quarter-health-campaign-v1"},
    "synthetic": {"const": true},
    "canonical_write": {"const": false},
    "persistence": {"const": "none"},
    "decision_candidate_id": {"$ref": "#/$defs/token"},
    "phases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/phase"}, {"properties": {"phase": {"const": 1}, "label": {"const": "起盘与稳定"}}}]},
        {"allOf": [{"$ref": "#/$defs/phase"}, {"properties": {"phase": {"const": 2}, "label": {"const": "实验与校准"}}}]},
        {"allOf": [{"$ref": "#/$defs/phase"}, {"properties": {"phase": {"const": 3}, "label": {"const": "证据复盘与沉淀"}}}]}
      ],
      "items": false
    },
    "active_phase": {"enum": [1, 2, 3]},
    "current_weekly_experiment_reference": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/token"}]},
    "candidate_state": {"const": "decision_candidate"},
    "claims": {"const": ["non_clinical", "not_treatment_plan", "outcome_not_adjudicated"]},
    "unknowns": {"$ref": "#/$defs/text_array"},
    "conflicts": {"$ref": "#/$defs/references"},
    "authority_gate": {"$ref": "#/$defs/authority_gate"}
  },
  "$defs": {
    "token": {"type": "string", "pattern": "^synthetic:[a-z0-9][a-z0-9._:-]{0,127}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 280, "pattern": "^Synthetic [A-Za-z0-9 ./-]+\\.$"},
    "references": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
    "text_array": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "label"],
      "properties": {"phase": {"type": "integer"}, "label": {"type": "string"}}
    },
    "authority_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "final_authority"],
      "properties": {"level": {"enum": ["GREEN", "YELLOW"]}, "final_authority": {"const": "subject"}}
    }
  }
}
